ENV=dev
DEBUG=true

# 数据库
DATABASE_URL=sqlite:///./data/adkxbox.db

# Redis
REDIS_URL=redis://redis:6379/0

# CORS（生产收紧）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT - 生产请用 openssl rand -base64 32 生成
JWT_SECRET=please-change-this-in-production-use-openssl-rand-base64-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 限流
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STORAGE=redis
